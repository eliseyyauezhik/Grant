filters:
  and:
    - file.inFolder("notes/sources")
    - 'type == "source"'
properties:
  file.name:
    displayName: Source
  source_id:
    displayName: ID
  kind:
    displayName: Kind
  status:
    displayName: Status
  url:
    displayName: URL
  owner:
    displayName: Owner
  last_verified:
    displayName: Verified
views:
  - type: table
    name: Sources
    order:
      - file.name
      - source_id
      - kind
      - status
      - owner
      - last_verified
